# Hugging Face checkpoint used for CLIP image embeddings.
BADMINTON_CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# Hugging Face checkpoint used for DINOv2 image embeddings.
BADMINTON_DINOV2_MODEL_NAME=facebook/dinov2-base

# Torchvision ResNet-50 weights enum member.
BADMINTON_RESNET_WEIGHTS_NAME=DEFAULT

# Ultralytics checkpoint and threshold used for object detection.
BADMINTON_DETECTION_MODEL_NAME=yolo11n.pt
BADMINTON_DETECTION_CONFIDENCE=0.25

# Ultralytics checkpoint and threshold used for instance segmentation.
BADMINTON_SEGMENTATION_MODEL_NAME=yolo11n-seg.pt
BADMINTON_SEGMENTATION_CONFIDENCE=0.25
# Optional: set to cpu if the GPU cannot fit full-resolution player masks.
# BADMINTON_SEGMENTATION_DEVICE=cpu

# Ultralytics tracker configuration bundled with the installed package.
BADMINTON_TRACKING_CONFIG_NAME=bytetrack.yaml
